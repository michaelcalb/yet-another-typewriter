{
    "name": "yats-typewriter",
    "version": "0.1.0",
    "description": "Yet Another TypeScript typewriter package. No dependencies required.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/michaelcalb/yats-typewriter.git"
    },
    "homepage": "https://github.com/michaelcalb/yats-typewriter#readme",
    "bugs": "https://github.com/michaelcalb/yats-typewriter/issues",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "keywords": [
        "typewriter",
        "typing",
        "animation",
        "text",
        "effect"
    ],
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "pnpm build",
        "test": "node --test test/*.test.ts"
    },
    "devDependencies": {
        "typescript": "^5"
    }
}
